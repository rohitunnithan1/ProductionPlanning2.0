# Google Sheets published CSV URL for the PDI_Database sheet.
# Steps to get this URL:
#   1. In Google Sheets, go to File > Share > Publish to web
#   2. In the first dropdown, select "PDI_Database" (the sheet tab)
#   3. In the second dropdown, select "Comma-separated values (.csv)"
#   4. Click "Publish" and copy the URL
#   5. Paste it here (without quotes)
#
# Example:
# SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/pub?gid=SHEET_GID&single=true&output=csv

SHEETS_CSV_URL=
